{
  "name": "@minih-agent/remote-gateway",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "description": "Self-hosted RACP Gateway: Host link (wss + mutual TLS) and the RACP-HTTP + SSE client API",
  "bin": {
    "remote-gateway": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-bundle',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@minih-agent/racp": "workspace:*",
    "@minih-agent/shared": "workspace:*",
    "asn1js": "3.0.10",
    "pkijs": "3.4.0",
    "typebox": "^1.3.13",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
